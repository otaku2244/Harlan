# ── 服务 ───────────────────────────────────────────
AION_HOST=127.0.0.1
AION_PORT=8080
# 数据库位置（默认仓库下的 data/aion.db）
# AION_DB_PATH=/opt/aion/data/aion.db

# ── 对话行为 ───────────────────────────────────────
# 指令续轮上限，防止模型反复吐指令导致死循环
MAX_DIRECTIVE_ROUNDS=3
# 注入模型的历史消息条数上限
HISTORY_LIMIT=40

# ── Serein（记忆服务）──────────────────────────────
# 实例根地址。不要加 /v1。
SEREIN_BASE_URL=http://100.x.x.x:8787
# 安装时生成的 Gateway Key。留在服务端，不要进前端 JS。
SEREIN_GATEWAY_KEY=
# 单轮最多带几张记忆卡（Serein 上限为 2）
SEREIN_MAX_NOTES=2
# 冷却：记多少条最近交付的召回 ID
SEREIN_DELIVERY_WINDOW=5

# ── 模型（OpenAI 兼容端点）─────────────────────────
# 例：https://api.siliconflow.cn/v1
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT=120
# 模型端点在公网时可能需要系统代理；Serein 在 Tailscale 内网，永远不走代理
MODEL_TRUST_ENV=1

# ── 人设 ───────────────────────────────────────────
# 首次建库时写入 actors 表。之后请在库里改（display_name），别再依赖这里。
AI_DISPLAY_NAME=Harlan
USER_DISPLAY_NAME=你
AI_PERSONA=

# ── spike.py 专用 ──────────────────────────────────
# openai = 真调模型；echo = 只打印组装好的上下文，不调模型
SPIKE_PROVIDER=openai
# spike 用的稳定窗口 ID
SEREIN_WINDOW_ID=spike-001
