# ── 服务 ───────────────────────────────────────────
AION_HOST=127.0.0.1
AION_PORT=8080
# 数据库位置（默认仓库下的 data/aion.db）
# AION_DB_PATH=/opt/aion/data/aion.db

# ── 对话行为 ───────────────────────────────────────
# 指令续轮上限，防止模型反复吐指令导致死循环
MAX_DIRECTIVE_ROUNDS=3
# 注入模型的历史消息条数上限
HISTORY_LIMIT=40
# 主动开口的输出上限（主动开口通常只有一两句话，限长能省 token）
WAKE_MAX_TOKENS=400

# ── 排查用 ─────────────────────────────────────────
# 设为 1 时打印 .env 加载与 settings 实例化的顺序（不含密钥）
# 排查"服务能起但配置全空"时非常有用
# AION_ENV_TRACE=1

# ── 唤醒调度（P3）──────────────────────────────────
# 后台轮询间隔（秒）。30 与原项目 ScheduleManager 一致。
SCHEDULER_POLL_SECONDS=30
# 是否启用后台调度（关掉后仍可用 POST /api/wake 手动触发）
SCHEDULER_ENABLED=1
# 空闲自主的随机间隔区间（分钟）。原项目默认 120，最小 5。
# 「随机要真」：间隔由随机数决定，选择做什么才交给模型。
IDLE_MIN_MINUTES=120
IDLE_MAX_MINUTES=120
# 主动开口落在哪个会话（前端据此显示）
WAKE_CONV_ID=harlan
# 记忆窗口前缀：每个角色一个稳定窗口，避免冷却串台
WAKE_WINDOW_PREFIX=wake

# ── Serein（记忆服务）──────────────────────────────
# 实例根地址。不要加 /v1。
SEREIN_BASE_URL=http://100.x.x.x:8787
# 安装时生成的 Gateway Key。留在服务端，不要进前端 JS。
SEREIN_GATEWAY_KEY=
# 单轮最多带几张记忆卡（Serein 上限为 2）
SEREIN_MAX_NOTES=2
# 冷却：记多少条最近交付的召回 ID
SEREIN_DELIVERY_WINDOW=5

# ── 模型（OpenAI 兼容端点）─────────────────────────
# 例：https://api.siliconflow.cn/v1
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT=120
# 模型端点在公网时可能需要系统代理；Serein 在 Tailscale 内网，永远不走代理
MODEL_TRUST_ENV=1

# ── 人设 ───────────────────────────────────────────
# 首次建库时写入 actors 表。之后请在库里改（display_name），别再依赖这里。
AI_DISPLAY_NAME=Harlan
USER_DISPLAY_NAME=你
AI_PERSONA=

# ── spike.py 专用 ──────────────────────────────────
# openai = 真调模型；echo = 只打印组装好的上下文，不调模型
SPIKE_PROVIDER=openai
# spike 用的稳定窗口 ID
SEREIN_WINDOW_ID=spike-001
